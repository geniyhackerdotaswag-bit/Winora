<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- For UpdateViewModel below: [ObservableProperty] and [RelayCommand] need the source generator. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <!--
    Winora.App is a WinUI 3 project, so its assembly carries a CsWinRT <Module> initializer that
    performs WinRT COM activation. Touching any type in it from a plain xUnit host fails with
    REGDB_E_CLASSNOTREG, even for a POCO. The presentation logic that has no WinUI dependency is
    therefore compiled into this test assembly from source instead of being referenced.
    The ViewModel dependency boundary is enforced authoritatively by Winora.Architecture.Tests,
    which reads source text and so cannot fail for environmental reasons.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Winora.App\Controls\FluentIconCatalog.cs" LinkBase="Linked\Controls" />
    <Compile Include="..\..\src\Winora.App\Navigation\RouteKeys.cs" LinkBase="Linked\Navigation" />
    <Compile Include="..\..\src\Winora.App\Navigation\RouteDescriptor.cs" LinkBase="Linked\Navigation" />
    <Compile Include="..\..\src\Winora.App\Navigation\RouteRegistry.cs" LinkBase="Linked\Navigation" />
    <Compile Include="..\..\src\Winora.App\ViewModels\CoordinatorDispositionPresentation.cs" LinkBase="Linked\ViewModels" />
    <!--
      UpdateViewModel touches no WinUI type either: it talks only to IAppUpdateService, IAppEnvironment,
      IDeploymentState, and ILocalizationService, none of which is a WinUI type. It links in the same
      way, together with the App-layer services it depends on.
    -->
    <Compile Include="..\..\src\Winora.App\ViewModels\UpdateViewModel.cs" LinkBase="Linked\ViewModels" />
    <Compile Include="..\..\src\Winora.App\Services\AppUpdateService.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\AppEnvironment.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\DeploymentState.cs" LinkBase="Linked\Services" />
    <!--
      RecoveryState is the way out of a state where every further change is refused, so it is worth
      covering. It touches no WinUI type, only Core and Infrastructure contracts, so it links in
      the same way — together with the one interface from the App layer that it needs.
    -->
    <Compile Include="..\..\src\Winora.App\Services\ILocalizationService.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\ActionJournalWriter.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\JournalAllowlist.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\OperationRollback.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\RecoveryState.cs" LinkBase="Linked\Services" />
    <!--
      ProfileViewModel touches no WinUI type either: it talks only to IProfileService and
      ILocalizationService. ProfileService in turn depends on IActionJournalReader (App-layer,
      hence linked here too) and on IUserProfileStore from Winora.Infrastructure (a ProjectReference,
      so it needs no linking of its own).
    -->
    <Compile Include="..\..\src\Winora.App\ViewModels\ProfileViewModel.cs" LinkBase="Linked\ViewModels" />
    <Compile Include="..\..\src\Winora.App\Services\ProfileService.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\src\Winora.App\Services\ActionJournalReader.cs" LinkBase="Linked\Services" />
    <!--
      RegistrationViewModel touches no WinUI type either: it talks only to IProfileService and
      ILocalizationService, the same pair ProfileViewModel depends on, so it links in the same way
      and needs no service of its own beyond what is already linked above.
    -->
    <Compile Include="..\..\src\Winora.App\ViewModels\RegistrationViewModel.cs" LinkBase="Linked\ViewModels" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winora.Core\Winora.Core.csproj" />
    <!-- For IChangePlanArchive, which RecoveryState depends on. -->
    <ProjectReference Include="..\..\src\Winora.Infrastructure\Winora.Infrastructure.csproj" />
    <!--
      For WindowsTempLocationProbe.AllLocationIds. The composition root joins that list to the
      action-journal allowlist; a test that could see only one side of the join could not tell
      whether the two still agree, which is the entire failure being guarded against.
    -->
    <ProjectReference Include="..\..\src\Winora.System\Winora.System.csproj" />
  </ItemGroup>
</Project>
