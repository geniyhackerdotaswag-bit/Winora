<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Required by the LibraryImport source generator for pinned by-reference parameters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The host list Winora writes over the one the release ships. Embedded rather than copied beside
      the executable so that it travels inside the single portable .exe, with an explicit name so
      the code does not depend on how the SDK derives one from the folder layout.
    -->
    <EmbeddedResource Include="Windows\Lists\list-general.txt" LogicalName="Winora.System.list-general.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Winora.Core\Winora.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The swap's double-failure path cannot be reached from outside: by the time the rescue move
      runs, the file it needs is one the previous rename just created, and nothing a test set up
      beforehand can be holding it. The seam below is the only way that branch gets covered, and
      the branch is the one that decides whether somebody is told their program is missing.
    -->
    <InternalsVisibleTo Include="Winora.System.Tests" />
  </ItemGroup>
</Project>
