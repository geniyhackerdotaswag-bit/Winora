<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">
  <Identity Name="Winora.App" Publisher="CN=Winora" Version="0.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="4370573d-525e-4af2-b3e3-d035695b3753" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Winora</DisplayName>
    <PublisherDisplayName>Winora</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!--
      MSIX otherwise redirects this app's HKCU writes into a container view and serves them back on
      read. Winora would then write a value, read its own write, report "applied and verified", and
      leave the real user hive untouched — a verification that lies, which is the one outcome this
      project exists to prevent.

      IMPORTANT, measured on 2026-07-31: this element does NOT take effect for an unsigned package
      registered with Add-AppxPackage -Register. Get-AppxPackage then reports SignatureKind None and
      IsDevelopmentMode True, and unvirtualizedResources is a restricted capability the OS does not
      grant to such a package even though it lists it. The observed symptom is asymmetric and
      confusing: deleting a value from an existing key propagates to the real hive, but the container
      keeps a tombstone that masks the value if something outside restores it, and a key the app
      creates itself exists only inside the container and is invisible from outside. The registry
      domains therefore cannot be trusted until the package is properly signed. Verify with a
      separate unpackaged process after any change to signing or to this element.

      Microsoft documents this element as intended for a narrow set of partner-published titles, so
      it is also incompatible with ordinary Store certification; the MVP ships sideloaded or through
      an enterprise channel, which the specification already fixes.
      Microsoft Learn: https://learn.microsoft.com/en-us/uwp/schemas/appxpackage/uapmanifestschema/element-desktop6-registrywritevirtualization
    -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Winora"
        Description="Safe Windows customization"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by windows.registryWriteVirtualization above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
