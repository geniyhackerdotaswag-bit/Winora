<?xml version="1.0" encoding="utf-8"?>
<!--
  Winora's own surfaces. Deliberately not a card-per-row list: that reads as a copy of the Windows
  Settings app. Rows live on one continuous grouped surface separated by hairlines, the page opens
  with a large title over an accent rule, and the interactive element sits at the right edge with a
  hover state on the whole row. Colours still come from native theme resources so High Contrast and
  the system accent keep working.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winora.App.Controls">

    <!-- Page header -->

    <!--
      The screen's name in the strip at the top. Twenty points, not forty: this sits beside the
      subtitle on one line rather than towering over a tinted band, and the pane on the left has
      already said which screen you are on.
    -->
    <Style x:Key="WinoraPageHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextPrimary}" />
    </Style>

    <Style x:Key="WinoraPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="52" />
        <!--
          Tight tracking, about -0.04 em. Display type set at default tracking is the single most
          reliable sign that nobody chose the typography.
        -->
        <Setter Property="CharacterSpacing" Value="-40" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="WinoraPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="{StaticResource WinoraBodyMaxWidth}" />
        <!-- Without this the capped width centres the line and it stops lining up with the title. -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!--
      The rule under a page title, in the hue of the navigation group the page belongs to. It is the
      one place the section colour appears at full strength, so "where am I" is answerable without
      reading anything.
    -->
    <Style x:Key="WinoraAccentRule" TargetType="Rectangle">
        <Setter Property="Height" Value="3" />
        <Setter Property="Width" Value="44" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="WinoraSectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- Surfaces -->

    <!--
      One surface holding many rows, rather than a card around each. The single rounded container is
      what stops the list reading as a stack of Settings tiles.
    -->
    <Style x:Key="WinoraGroup" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WinoraGroupRadius}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <!--
      Cards. The stock card fill is designed to sit on an opaque window background; on Winora's
      translucent content sheet it vanished, which is most of why the screens read as flat. These
      are a measured step brighter than the sheet, with a stroke you can actually see.
    -->
    <Style x:Key="WinoraCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WinoraCardFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WinoraCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WinoraCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource WinoraCardPadding}" />
    </Style>

    <!--
      A setting tile. The bar down the leading edge carries the section hue and its opacity follows
      the switch, so a wall of tiles shows at a glance which settings are on — the switch alone made
      sixteen tiles read as one grey field.
    -->
    <Style x:Key="WinoraTile" TargetType="Border" BasedOn="{StaticResource WinoraCard}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
      A tile that is itself the click target. Used where the card *is* the choice — picking a
      shortcut, picking an icon — so the whole card highlights and takes focus rather than hiding
      the action behind a small button in one corner.
    -->
    <Style x:Key="WinoraSelectableTile" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource WinoraCardFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WinoraCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WinoraCardRadius}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="TileRoot"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.16" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="TileRoot.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="TileRoot.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TileRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A round, quiet button for the community link. It carries a glyph and no text, so it is sized
      to the touch minimum rather than to its content, and it lifts on hover to read as clickable
      without a border shouting for attention on an otherwise empty page.
    -->
    <!--
      The container for the version line, stripped bare.

      NavigationView wraps anything put into FooterMenuItems in a NavigationViewItem, and that
      brought the whole item chrome with it: a rounded fill, a hover state and a selection
      highlight. The row looked like a button and invited a click that does nothing — the version
      is a fact, and the only thing here that answers a press is the community mark beside it,
      which is a Button in its own right and keeps its own chrome.

      A template of one ContentPresenter is the whole of it. Turning the states off one property at
      a time leaves whichever one is added to the default template next.
    -->
    <Style x:Key="WinoraPaneSignature" TargetType="NavigationViewItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SelectsOnInvoked" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItem">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The version at the foot of the pane. Deliberately the quietest text in the window: it is there
      to be found when looked for, not to be read on the way past.
    -->
    <!--
      A bypass strategy's name. Monospaced on purpose: these are the release's own file names, kept
      byte for byte, and their whole job is to be matched against a line in a forum thread that
      says "try ALT3". Set in the body face they read as a label somebody should understand; set
      like this they read as what they are.
    -->
    <Style x:Key="WinoraStrategyId" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WinoraPaneVersion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WinoraCommunityButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource WinoraCardFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WinoraCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="22">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.16" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinoraTileBar" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,10,0,10" />
        <Setter Property="Fill" Value="{ThemeResource WinoraHuePersonalization}" />
    </Style>

    <!--
      Implicit style, so every row on every grouped surface highlights the same way just by being a
      HoverRow. The brush is a native subtle fill: High Contrast substitutes its own.
    -->
    <Style TargetType="controls:HoverRow">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HoverRow">
                    <Grid x:Name="RowRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="PointerOver"
                                                      GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="Normal"
                                                      GeneratedDuration="0:0:0.16" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RowRoot.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The hairline between rows inside a group. -->
    <Style x:Key="WinoraRowDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <!-- Row text -->

    <Style x:Key="WinoraRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WinoraRowDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--
      Row notes are statements of fact, not alarms: what clearing a folder costs, why a control is
      unavailable. Painting every one of them caution-yellow made ordinary screens look like
      something had gone wrong, and left no colour in reserve for when it actually had. They read as
      ordinary secondary text now; a real problem gets an InfoBar, which is loud on purpose.
    -->
    <Style x:Key="WinoraRowWarning" TargetType="TextBlock" BasedOn="{StaticResource WinoraRowDetail}" />

    <!--
      Buttons.

      The stock WinUI button only swaps its background on press, which on a large button reads as a
      flicker rather than as a press. This template adds PointerDownThemeAnimation — the platform's
      own press scale — so the button physically gives under the pointer, and puts real transition
      durations on the colour change so hover and release ease instead of snapping.
    -->
    <Style x:Key="WinoraActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="PressRoot"
                          Background="{ThemeResource ControlFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource WinoraControlRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.10" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Background"
                                                Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Setter Target="PressRoot.BorderBrush"
                                                Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Background"
                                                Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <!-- The platform press scale, the part the stock style omits. -->
                                        <PointerDownThemeAnimation Storyboard.TargetName="PressRoot" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Background"
                                                Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                        <Setter Target="Label.Foreground"
                                                Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="Label"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A number that should read at a glance, for the dashboard and the cleanup total. -->
    <Style x:Key="WinoraMetric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WinoraMetricCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      The registration card.

      These live here rather than inside the window because a style dictionary is where this project
      keeps the look of a surface, and because the window's markup is long enough already without
      four copies of a button template inside it.

      Their colours are written out rather than taken from the palette, and that is deliberate. The
      welcome card is the one screen shown before anybody has chosen a scheme — it is the screen on
      which that choice has not happened yet — so it wears the fixed dark look of the reference the
      owner supplied. Every screen after registration follows the palette as before.
    -->

    <Style x:Key="WinoraRegistrationBadge" TargetType="Border">
        <Setter Property="Background" Value="#141418" />
        <Setter Property="BorderBrush" Value="#26262C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,4,12,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="WinoraRegistrationBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#B9B9C2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WinoraRegistrationTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F4F4F6" />
        <Setter Property="LineHeight" Value="29" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WinoraRegistrationSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#8E8E96" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WinoraRegistrationLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#A9A9B2" />
    </Style>

    <Style x:Key="WinoraRegistrationValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#F4F4F6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WinoraRegistrationRule" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#8E8E96" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A refusal, and the only thing on this card allowed to be red. -->
    <Style x:Key="WinoraRegistrationError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#F87171" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      The chrome of a field. The TextBox inside is stripped to nothing by the brush overrides the
      window declares, so this border is the whole visible field: it can therefore turn red or green
      without fighting the control's own visual states, which overwrite BorderBrush on hover and on
      focus and would take the colour away exactly when somebody is looking at the field.
    -->
    <Style x:Key="WinoraRegistrationFieldShell" TargetType="Border">
        <Setter Property="Background" Value="#0E0E12" />
        <Setter Property="BorderBrush" Value="#26262C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- An inner panel: the requirement checklist, and the summary on the last screen. -->
    <Style x:Key="WinoraRegistrationSurface" TargetType="Border">
        <Setter Property="Background" Value="#0E0E12" />
        <Setter Property="BorderBrush" Value="#1E1E24" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--
      The card's buttons.

      A template of its own rather than one based on WinoraActionButton, because that one paints its
      background from a theme resource and so cannot be made white. Here the states move opacity
      instead of colour, which lets a single template serve both the white action button and the
      dark one standing beside it.
    -->
    <Style x:Key="WinoraRegistrationButton" TargetType="Button">
        <Setter Property="Padding" Value="18,10,18,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="PressRoot"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.10" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Opacity" Value="0.88" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <!-- The platform press scale, as WinoraActionButton uses. -->
                                        <PointerDownThemeAnimation Storyboard.TargetName="PressRoot" />
                                    </Storyboard>
                                </VisualState>

                                <!--
                                  Dead, not merely dimmer. The reference greys the action out until
                                  the step has been answered, and a button that still looks pressable
                                  while doing nothing is worse than one that plainly cannot be
                                  pressed.
                                -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Opacity" Value="0.28" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="Label"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one thing on each screen that moves it forward. -->
    <Style x:Key="WinoraRegistrationPrimaryButton" TargetType="Button" BasedOn="{StaticResource WinoraRegistrationButton}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#08080A" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WinoraRegistrationSecondaryButton" TargetType="Button" BasedOn="{StaticResource WinoraRegistrationButton}">
        <Setter Property="Background" Value="#141418" />
        <Setter Property="Foreground" Value="#D5D5DC" />
        <Setter Property="BorderBrush" Value="#26262C" />
    </Style>

    <!-- A domain offered on the email step: the same dark button, smaller. -->
    <Style x:Key="WinoraRegistrationChipButton" TargetType="Button" BasedOn="{StaticResource WinoraRegistrationSecondaryButton}">
        <Setter Property="Padding" Value="10,5,10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
      The card's own close button, standing in for the system caption button the borderless
      window no longer has. A template of its own rather than the theme's Button states, for the
      same reason WinoraRegistrationButton has one: this card's palette is fixed regardless of the
      user's scheme, and the default Button reads its pointer-over and pressed backgrounds from
      theme resources that would fight it.
    -->
    <Style x:Key="WinoraRegistrationCloseButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#9A9AA2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="PressRoot"
                          Background="{TemplateBinding Background}"
                          CornerRadius="7">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.16" />
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.10" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Background" Value="#1B1B21" />
                                        <Setter Target="Glyph.Foreground" Value="#F4F4F6" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Background" Value="#26262C" />
                                        <Setter Target="Glyph.Foreground" Value="#F4F4F6" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PressRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="Glyph"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The cabinet's form language.

      The registration card and the personal cabinet are meant to read as one product, so the
      geometry below is the registration card's: a 42-pixel field with a 10-pixel corner and room
      at its leading edge for an icon, a header strip across the top of a card, and one flat button
      that carries the action.

      The colours are not the registration card's, and that difference is the whole point. That
      card writes its palette out because it is the one screen shown before anybody has chosen a
      scheme. Every screen inside the program is shown after, so these read the palette and follow
      the scheme the user picked — a cabinet painted in fixed greys would be the one page that
      ignored the choice made two screens earlier.
    -->

    <!-- The caption above a field, and the title inside a card's header strip. -->
    <Style x:Key="WinoraFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextSecondary}" />
    </Style>

    <!--
      A field with room for a leading icon.

      Based on the platform's own TextBox style rather than started from nothing, so the template,
      the focus underline, the selection colours and High Contrast all keep working and only the
      geometry changes. The left padding is the icon's column: the icon is a sibling in a Grid, not
      part of the control, so nothing in here has to know it is there.
    -->
    <Style x:Key="WinoraFieldBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="38,9,12,9" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--
      The strip across the top of a card, as the registration card wears one.

      Its radius is the card radius written out rather than taken from WinoraCardRadius, because a
      CornerRadius resource cannot be read one corner at a time and a strip rounded on all four
      shows the card's own colour in the two gaps at the top.
    -->
    <Style x:Key="WinoraCardHeaderStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WinoraHoverBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WinoraDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="14,14,0,0" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="Height" Value="44" />
    </Style>

    <!--
      The one button on a screen that commits what was typed.

      The template is the registration card's, reused rather than copied out: it moves opacity
      instead of colour on hover and on press, which is what lets a solid fill stay solid, and it
      goes flatly dead rather than merely dimmer while the form cannot be answered. Only the two
      colours are the palette's. WinoraHueSystem is near-white on a dark scheme and near-black on a
      light one, with WinoraOnAccentBrush the inverse of it, so this is the reference's white
      button on the scheme it was drawn for and the right button on every other.
    -->
    <Style x:Key="WinoraPrimaryButton" TargetType="Button" BasedOn="{StaticResource WinoraRegistrationButton}">
        <Setter Property="Background" Value="{ThemeResource WinoraHueSystem}" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- The name on the profile card: the largest thing on the screen after the page title. -->
    <Style x:Key="WinoraProfileName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The quieter lines under it: the address, and the day they arrived. -->
    <Style x:Key="WinoraProfileDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource WinoraTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
