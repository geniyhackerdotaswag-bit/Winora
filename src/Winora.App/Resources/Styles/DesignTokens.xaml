<?xml version="1.0" encoding="utf-8"?>
<!--
  The approved token grid from specification section 12. These are the only spacing, radius, and
  icon sizes allowed; a screen that needs a value not listed here needs a specification change,
  not a local override.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing scale -->
    <x:Double x:Key="WinoraSpacingXs">4</x:Double>
    <x:Double x:Key="WinoraSpacingS">8</x:Double>
    <x:Double x:Key="WinoraSpacingM">12</x:Double>
    <x:Double x:Key="WinoraSpacingL">16</x:Double>
    <x:Double x:Key="WinoraSpacingXl">24</x:Double>
    <x:Double x:Key="WinoraSpacing2Xl">32</x:Double>
    <x:Double x:Key="WinoraSpacing3Xl">40</x:Double>
    <x:Double x:Key="WinoraSpacing4Xl">48</x:Double>

    <Thickness x:Key="WinoraPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="WinoraCardPadding">16</Thickness>
    <Thickness x:Key="WinoraStackGapS">0,0,0,8</Thickness>
    <Thickness x:Key="WinoraStackGapM">0,0,0,12</Thickness>
    <Thickness x:Key="WinoraStackGapL">0,0,0,16</Thickness>
    <Thickness x:Key="WinoraStackGapXl">0,0,0,24</Thickness>

    <!-- Corner radii -->
    <CornerRadius x:Key="WinoraControlRadius">4</CornerRadius>
    <!-- Larger than the platform default: big soft corners are most of what makes a surface
         read as designed rather than as a default control. -->
    <CornerRadius x:Key="WinoraCardRadius">14</CornerRadius>
    <CornerRadius x:Key="WinoraFlyoutRadius">12</CornerRadius>

    <!-- A grouped surface holds many rows, so it carries the larger radius of the two. -->
    <CornerRadius x:Key="WinoraGroupRadius">16</CornerRadius>

    <Thickness x:Key="WinoraRowPadding">16,14,16,14</Thickness>

    <!-- Icon geometry: one size for every icon, one container size per surface -->
    <x:Double x:Key="WinoraIconSize">20</x:Double>
    <x:Double x:Key="WinoraIconContainerCard">32</x:Double>
    <x:Double x:Key="WinoraIconContainerFeature">36</x:Double>

    <!-- Shell metrics -->
    <x:Double x:Key="WinoraNavigationPaneWidth">240</x:Double>
    <x:Double x:Key="WinoraMinWindowWidth">1040</x:Double>
    <x:Double x:Key="WinoraMinWindowHeight">720</x:Double>
    <x:Double x:Key="WinoraBodyMaxWidth">880</x:Double>

    <!-- Motion: 160-220 ms with native Fluent easing, honoured only when animations are enabled -->
    <x:Double x:Key="WinoraMotionFastMilliseconds">160</x:Double>
    <x:Double x:Key="WinoraMotionStandardMilliseconds">220</x:Double>

</ResourceDictionary>
