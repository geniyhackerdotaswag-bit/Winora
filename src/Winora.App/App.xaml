<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Winora.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winora.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/DesignTokens.xaml" />
                <!-- Palette before Controls: the control styles reference the hue brushes. -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Palette.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Controls.xaml" />
                <!-- Navigation last: it restyles the stock NavigationView using the hues above. -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Navigation.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
