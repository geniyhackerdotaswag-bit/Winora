<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Winora.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winora.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/DesignTokens.xaml" />
                <!-- Palette before Controls: the control styles reference the hue brushes. -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Palette.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Controls.xaml" />
                <!-- Navigation last: it restyles the stock NavigationView using the hues above. -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Navigation.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Every FontIcon in the app draws with this. The value here is only the placeholder
                that makes the key exist for the parser; App's constructor replaces it with the font
                this machine actually has, before any page is parsed. Windows 10 and stripped builds
                have no Segoe Fluent Icons, and there every icon drew as an empty box.
            -->
            <FontFamily x:Key="WinoraIconFontFamily">Segoe Fluent Icons</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
