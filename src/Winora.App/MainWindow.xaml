<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Winora.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Winora">
    <!--
      No system backdrop. Mica was dropped when the colour scheme became the user's to choose: the
      backdrop tints itself from the desktop wallpaper, which meant a chosen background was never
      quite the colour it said it was, and every contrast measurement had to guess at a tint Winora
      cannot read. A flat opaque canvas makes the arithmetic exact and the shown colour the real one.
    -->
    <Grid x:Name="RootGrid" Background="{ThemeResource WinoraCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          The app's own title bar. The stock caption makes every WinUI app look like the same
          Win32 window; carrying the mark up here is most of what separates Winora on sight.
          The right-hand column is left empty for the system caption buttons.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <!--
                  The application's own mark, the same artwork the taskbar and Start show.

                  AppMark.png and not Square44x44Logo.scale-200.png, which is what stood here and
                  showed nothing in the portable build. That name carries a resource qualifier, and
                  MRT reads ".scale-200" as "pick the right scale for this display" rather than as
                  part of a file name — so it looks for an unqualified Square44x44Logo, which does
                  not exist. A packaged app has a PRI that maps the two; an unpackaged one does not,
                  and the image silently resolved to nothing. This file has no qualifier to
                  misread.
                -->
                <Image Source="ms-appx:///Assets/AppMark.png"
                       Width="20"
                       Height="20"
                       VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
                <!-- Text set from resources in the constructor, like every other string here. -->
                <TextBlock x:Name="AppTitleText"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!--
          The one place the app tells you about itself. Collapsed unless there is something to say:
          a strip that is always present, saying everything is fine, is a strip people stop reading.
        -->
        <InfoBar x:Name="UpdateBar"
                 Grid.Row="1"
                 Margin="16,0,16,12"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateAction" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <ProgressBar x:Name="UpdateProgress"
                             Margin="0,8,0,8"
                             Maximum="1"
                             Visibility="Collapsed" />
            </InfoBar.Content>
        </InfoBar>

        <NavigationView x:Name="Navigation"
                        Grid.Row="2"
                        OpenPaneLength="{StaticResource WinoraNavigationPaneWidth}"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <!--
              The content sits on its own raised surface with a rounded leading corner, so the page
              reads as a sheet laid over the window rather than as the window's own background.
            -->
            <Border Background="{ThemeResource WinoraContentSurfaceBrush}"
                    BorderBrush="{ThemeResource WinoraContentSurfaceStroke}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="12,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </NavigationView>
    </Grid>
</Window>
