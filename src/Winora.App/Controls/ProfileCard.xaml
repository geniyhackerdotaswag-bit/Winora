<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winora.App.Controls.ProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      One control, two homes: the cabinet and the dashboard. Written once so the two cannot drift
      apart, which two copies of the same markup always eventually do.

      It is the centrepiece of the cabinet now rather than a tile in the corner of it. The avatar is
      large enough to be the anchor of the screen, the name is set as a heading rather than as row
      text, and the address and the joining date are the quiet lines beneath it — the shape of the
      registration card, in the colours of whatever scheme the user chose.

      The two figures along the bottom are every number Winora actually holds about a person. They
      live in the card rather than on a panel of their own because the card is shared: the dashboard
      gets them for free, and there is one place to change them when a third arrives.
    -->
    <Border Style="{StaticResource WinoraCard}" Padding="0">
      <Grid>

        <!--
          The chosen background, and a sheet of the card's own colour over it.

          Two layers, not one. The picture is an ImageBrush on a Border's Background rather than an
          Image element, so the corner radius does the clipping — a Border always paints its
          background inside its own radius, whether or not it would clip a child.

          The sheet is the part that is not decoration. Raw photograph behind this card's text is
          unreadable at some point in every photograph: the name is WinoraTextPrimary and the two
          quiet lines are WinoraTextMuted, both chosen against WinoraCardFill and against nothing
          else. At 0.86 the worst case a picture can produce — pure white under the dark scheme,
          pure black under the light one — still leaves the muted tone above 5:1 on both, which is
          measured arithmetic rather than a look at it. Both layers use the palette rather than a
          fixed black, because this card is only ever shown after a scheme has been chosen.

          The radius is 13 rather than the card's 14: the card carries a one-pixel border, so its
          child sits one pixel inside it, and 14 would overhang the curve by exactly that pixel.
        -->
        <Border x:Name="Backdrop"
                CornerRadius="13"
                Visibility="Collapsed" />
        <Border x:Name="BackdropScrim"
                Background="{ThemeResource WinoraCardFill}"
                CornerRadius="13"
                Opacity="0.86"
                Visibility="Collapsed" />

        <StackPanel Margin="24">

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Drawn, not an image: nothing to ship and no blur at any size. -->
                <Grid Grid.Column="0"
                      Width="96"
                      Height="96"
                      VerticalAlignment="Center">
                    <!--
                      The person's colour twice over: a faint halo behind a solid disc. One brush
                      serves both, because the softening is opacity on the shape rather than alpha
                      in the colour.
                    -->
                    <Ellipse x:Name="AvatarHalo" Opacity="0.16" />
                    <Ellipse x:Name="AvatarCircle" Width="76" Height="76" />

                    <!--
                      The picture, when there is one, in the disc's place. An Ellipse filled with an
                      ImageBrush set to UniformToFill is the square centre crop and the circle in one
                      step, with no pixels touched and nothing to get wrong: the brush scales the
                      picture to cover the disc and centres what it cannot fit.

                      The halo behind it stays. It is the person's palette colour, which a picture
                      borrows the card for rather than replaces — and which comes straight back if
                      the picture is removed.
                    -->
                    <Ellipse x:Name="AvatarPicture"
                             Width="76"
                             Height="76"
                             Visibility="Collapsed" />
                    <TextBlock x:Name="AvatarInitial"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="CardName" Style="{StaticResource WinoraProfileName}" />

                    <StackPanel Spacing="6">
                        <Grid x:Name="EmailRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      AutomationProperties.AccessibilityView="Raw"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="13"
                                      Foreground="{ThemeResource WinoraTextFaint}"
                                      Glyph="&#xE715;"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="CardEmail"
                                       Style="{StaticResource WinoraProfileDetail}" />
                        </Grid>

                        <Grid x:Name="SinceRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      AutomationProperties.AccessibilityView="Raw"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="13"
                                      Foreground="{ThemeResource WinoraTextFaint}"
                                      Glyph="&#xE787;"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="CardSince"
                                       Style="{StaticResource WinoraProfileDetail}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--
              Both the rule and the figures go when there are no figures yet: the statistics arrive
              from the journal a moment after the rest of the card, and a hairline over two blank
              captions is exactly the unfinished look this control was rewritten to remove.
            -->
            <Rectangle x:Name="StatsRule"
                       Height="1"
                       Fill="{ThemeResource WinoraDividerBrush}"
                       Margin="0,22,0,18" />

            <StackPanel x:Name="Stats" Orientation="Horizontal" Spacing="56">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ChangesValue" Style="{StaticResource WinoraMetric}" />
                    <TextBlock x:Name="ChangesCaption" Style="{StaticResource WinoraMetricCaption}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DaysValue" Style="{StaticResource WinoraMetric}" />
                    <TextBlock x:Name="DaysCaption" Style="{StaticResource WinoraMetricCaption}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
</UserControl>
