<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:conv="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Margin="{StaticResource WinoraStackGapL}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraSectionHeading}"
                       Text="{x:Bind ViewModel.CountSummary, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupEntryRowViewModel">
                        <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapM}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Command}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{x:Bind Note, Mode=OneWay}"
                                               Visibility="{x:Bind conv:XamlConvert.Show(HasNote)}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind SourceBadge}" />
                                    <Grid HorizontalAlignment="Right">
                                        <ToggleSwitch IsOn="{x:Bind SwitchValue, Mode=TwoWay}"
                                                      OnContent=""
                                                      OffContent=""
                                                      MinWidth="0"
                                                      IsEnabled="{x:Bind IsChangeable, Mode=OneWay}"
                                                      Toggled="OnToggled"
                                                      Tag="{x:Bind}"
                                                      AutomationProperties.Name="{x:Bind Name}"
                                                      AutomationProperties.HelpText="{x:Bind Note, Mode=OneWay}" />
                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                      Visibility="{x:Bind conv:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                      Width="20" Height="20"
                                                      HorizontalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
