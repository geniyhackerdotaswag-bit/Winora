<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--
              Full-bleed header band in the section hue. It runs the whole width of the sheet while
              the body below stays inside a capped column, so the colour belongs to the page rather
              than to a card sitting on it.
            -->
            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <!--
                  A star column with a cap: the content fills the width up to a comfortable measure
                  and then stops, staying at the left edge instead of drifting into the middle.
                -->
                <ColumnDefinition Width="*" MaxWidth="1800" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Padding="32,20,32,32">


                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Margin="{StaticResource WinoraStackGapL}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <TextBlock Style="{StaticResource WinoraSectionHeading}"
                           Text="{x:Bind ViewModel.CountSummary, Mode=OneWay}" />

                <Border Style="{StaticResource WinoraGroup}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupEntryRowViewModel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ctl:HoverRow Grid.Row="0">
                                        <Grid Padding="{StaticResource WinoraRowPadding}" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource WinoraRowTitle}" Text="{x:Bind Name}" />
                                                <!-- The command is the entry's identity, not a hint about it. -->
                                                <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                           Text="{x:Bind Command}"
                                                           IsTextSelectionEnabled="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Style="{StaticResource WinoraRowWarning}"
                                                           Text="{x:Bind Note, Mode=OneWay}"
                                                           Visibility="{x:Bind ctl:XamlConvert.Show(HasNote), Mode=OneWay}" />
                                            </StackPanel>

                                            <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="44">
                                                <!-- The switch stands down while the ring is up. -->
                                                <ToggleSwitch IsOn="{x:Bind SwitchValue, Mode=TwoWay}"
                                                              OnContent=""
                                                              OffContent=""
                                                              MinWidth="0"
                                                              HorizontalAlignment="Right"
                                                              Visibility="{x:Bind ctl:XamlConvert.Hide(IsBusy), Mode=OneWay}"
                                                              IsEnabled="{x:Bind IsChangeable, Mode=OneWay}"
                                                              Toggled="OnToggled"
                                                              Tag="{x:Bind}"
                                                              AutomationProperties.Name="{x:Bind Name}"
                                                              AutomationProperties.HelpText="{x:Bind Note, Mode=OneWay}" />
                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind ctl:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                              Width="18" Height="18"
                                                              HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </ctl:HoverRow>

                                    <Rectangle Grid.Row="1" Style="{StaticResource WinoraRowDivider}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
