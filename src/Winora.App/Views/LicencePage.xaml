<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.LicencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,20,32,32">

                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Informational"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <!-- What is running, when there is something running. -->
                    <Border Style="{StaticResource WinoraCard}"
                            Margin="{StaticResource WinoraStackGapL}"
                            Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.HasLicence), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource WinoraRowTitle}"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource WinoraActionButton}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsBusy), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}"
                                        Click="OnRefreshClick" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsBusy), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.ForgetLabel, Mode=OneWay}"
                                        Click="OnForgetClick" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsBusy), Mode=OneWay}"
                                              Width="18" Height="18"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                      The entry form, shown only while there is no key here. Hiding it afterwards is
                      not tidiness: a second key entered over a working one would take another
                      machine slot from the same subscription for nothing.
                    -->
                    <Border Style="{StaticResource WinoraCard}"
                            Margin="{StaticResource WinoraStackGapL}"
                            Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.ShowEntry), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Description, Mode=OneWay}" />

                            <TextBox Text="{x:Bind ViewModel.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.KeyPlaceholder, Mode=OneWay}"
                                     FontFamily="Consolas"
                                     FontSize="16"
                                     MaxWidth="420"
                                     HorizontalAlignment="Left"
                                     IsSpellCheckEnabled="False" />

                            <TextBox Text="{x:Bind ViewModel.PromoCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.PromoPlaceholder, Mode=OneWay}"
                                     MaxWidth="420"
                                     HorizontalAlignment="Left"
                                     IsSpellCheckEnabled="False" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource WinoraActionButton}"
                                        IsEnabled="{x:Bind ViewModel.CanActivate, Mode=OneWay}"
                                        Content="{x:Bind ViewModel.ActivateLabel, Mode=OneWay}"
                                        Click="OnActivateClick" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsBusy), Mode=OneWay}"
                                              Width="18" Height="18"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
