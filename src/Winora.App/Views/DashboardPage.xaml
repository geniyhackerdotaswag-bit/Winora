<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Two rows so the community button can sit in the bottom corner of the page, not after the
         content: the page is otherwise empty and a button in the flow would float in the middle. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid Background="{ThemeResource WinoraHeaderPersonalization}" Padding="32,28,32,26">
                    <FontIcon Glyph="&#xE80F;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="112"
                              Opacity="0.06"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,48,0"
                              IsHitTestVisible="False"
                              AutomationProperties.AccessibilityView="Raw" />

                    <StackPanel MaxWidth="1800" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource WinoraPageTitle}"
                                   Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <Rectangle Style="{StaticResource WinoraRulePersonalization}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1800" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Padding="32,24,32,32">

                        <ctl:ProfileCard x:Name="Card" Margin="{StaticResource WinoraStackGapL}" />

                        <!--
                          The one thing this page still says, and only when it is true: an
                          unfinished change blocks every other screen, so a person who does not
                          see it here meets it as a click that refuses.
                        -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasRecovery, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Warning"
                                 Margin="{StaticResource WinoraStackGapL}"
                                 Message="{x:Bind ViewModel.RecoveryNotice, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="{x:Bind ViewModel.RecoveryActionLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsRecovering), Mode=OneWay}"
                                        Click="OnRecoverClick" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--
          Small, out of the way, and no text: the page has nothing else on it and a full card for
          one link dominated it. The tooltip and the automation name carry the meaning, so the
          button is not a mystery to a screen reader or to a pointer that pauses on it.
        -->
        <Button Grid.Row="1"
                Style="{StaticResource WinoraCommunityButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                ToolTipService.ToolTip="{x:Bind ViewModel.CommunityTooltip, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.CommunityTooltip, Mode=OneWay}"
                Click="OnCommunityClick">
            <Viewbox Width="22" Height="22">
                <!--
                  Data is set in code-behind from FluentIconCatalog, the one place the mark is
                  written down. It cannot be a shared XAML resource: see IconGeometry.
                -->
                <Canvas Width="24" Height="24">
                    <Path x:Name="CommunityGlyph" Fill="{ThemeResource WinoraCommunityGlyphBrush}" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</Page>
