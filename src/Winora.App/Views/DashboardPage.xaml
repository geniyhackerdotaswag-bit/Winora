<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid Background="{ThemeResource WinoraHeaderPersonalization}" Padding="32,28,32,26">
                    <FontIcon Glyph="&#xE80F;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="112"
                              Opacity="0.06"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,48,0"
                              IsHitTestVisible="False"
                              AutomationProperties.AccessibilityView="Raw" />

                    <StackPanel MaxWidth="1800" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource WinoraPageTitle}"
                                   Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <Rectangle Style="{StaticResource WinoraRulePersonalization}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1800" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Padding="32,24,32,32">

                        <ctl:ProfileCard x:Name="Card" Margin="{StaticResource WinoraStackGapL}" />

                        <!--
                          The four things the program is opened in order to do. They wrap rather
                          than shrink: no minimum size is set on the window, so it can be narrowed
                          to anything, and four tiles pinned side by side would have survived that
                          badly. UniformGridLayout moves one to the next row as soon as the width
                          for it is not there.

                          Two columns at most, so four tiles are a square and never three with a
                          straggler underneath. Left free, the row count follows the window and
                          lands on three at the default width, which reads as an accident rather
                          than as an arrangement. Two columns still collapse to one when the window
                          is narrowed past them; the cap is on how wide it may spread, not on how
                          far it may shrink.

                          Filled in the code-behind, one tile at a time, because what the view model
                          holds are two keys per tile and neither a resource key nor a catalog key
                          can be turned into something visible by markup.
                        -->
                        <ItemsRepeater x:Name="QuickActions"
                                       Margin="{StaticResource WinoraStackGapL}"
                                       ItemsSource="{x:Bind ViewModel.QuickActions, Mode=OneWay}"
                                       ElementPrepared="OnQuickTilePrepared"
                                       ElementClearing="OnQuickTileClearing">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240"
                                                   MinItemHeight="76"
                                                   MinColumnSpacing="12"
                                                   MinRowSpacing="12"
                                                   MaximumRowsOrColumns="2"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <ctl:QuickTile />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!--
                          The one thing this page still says, and only when it is true: an
                          unfinished change blocks every other screen, so a person who does not
                          see it here meets it as a click that refuses.
                        -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasRecovery, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Warning"
                                 Margin="{StaticResource WinoraStackGapL}"
                                 Message="{x:Bind ViewModel.RecoveryNotice, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="{x:Bind ViewModel.RecoveryActionLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsRecovering), Mode=OneWay}"
                                        Click="OnRecoverClick" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
