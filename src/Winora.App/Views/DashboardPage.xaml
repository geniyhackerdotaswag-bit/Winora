<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.SafetyStatement, Mode=OneWay}" />

            <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapM}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.CompatibilityNote, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapM}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}" />
                    <!-- Blocked capabilities are stated, not hidden behind a healthy-looking total. -->
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind conv:XamlConvert.Show(ViewModel.HasBlocked), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.BlockedSummary, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="{x:Bind conv:XamlConvert.InfoSeverity(ViewModel.CanApplyChanges), Mode=OneWay}"
                     Message="{x:Bind ViewModel.DeploymentNote, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
