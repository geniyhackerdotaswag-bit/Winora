<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.ResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}" x:Name="Heading" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsBusy), Mode=OneWay}"
                          HorizontalAlignment="Left"
                          Margin="{StaticResource WinoraStackGapL}" />

            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource WinoraStackGapL}"
                       Text="{x:Bind ViewModel.ResultDetail, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <!--
                  On a failed verification this is the primary action: the user's first need is to get
                  the machine back to the state they started from.
                -->
                <Button x:Name="RollbackButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.CanRollback), Mode=OneWay}"
                        Command="{x:Bind ViewModel.RollbackCommand}" />
                <Button x:Name="BackButton"
                        Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
