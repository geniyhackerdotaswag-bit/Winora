<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.StatusBody, Mode=OneWay}" />

            <!--
              An explicit "in development" statement satisfies interaction contract item 6.
              A blank frame or an inert card would not.
            -->
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
