<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.BackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,20,32,32">

                    <!--
                      First, because the word "backups" invites the wrong expectation. These copy
                      Winora's own records, not Windows settings, and a user who restores one hoping
                      their desktop will change would conclude the feature is broken.
                    -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Informational"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="{StaticResource WinoraStackGapL}">
                        <Grid MinWidth="160">
                            <Button Style="{StaticResource WinoraActionButton}"
                                    Content="{x:Bind ViewModel.CreateLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ctl:XamlConvert.Hide(ViewModel.IsBusy), Mode=OneWay}"
                                    Click="OnCreateClick" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsBusy), Mode=OneWay}"
                                          Width="18" Height="18"
                                          HorizontalAlignment="Left" />
                        </Grid>

                        <Button Style="{StaticResource WinoraActionButton}"
                                Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}"
                                Click="OnRefreshClick" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,0"
                               Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsEmpty), Mode=OneWay}"
                               Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StateBackupViewModel">
                                <Border Style="{StaticResource WinoraTile}" Margin="0,0,0,8">
                                    <ctl:HoverRow>
                                        <Grid Padding="18,14" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                           Text="{x:Bind When, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                           Text="{x:Bind Verified, Mode=OneWay}" />
                                            </StackPanel>

                                            <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="40">
                                                <Button Style="{StaticResource WinoraActionButton}"
                                                        Content="{x:Bind RestoreLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind ctl:XamlConvert.Show(CanRestore), Mode=OneWay}"
                                                        Click="OnRestoreClick"
                                                        AutomationProperties.Name="{x:Bind When, Mode=OneWay}" />

                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind ctl:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                              Width="18" Height="18" />
                                            </Grid>
                                        </Grid>
                                    </ctl:HoverRow>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
