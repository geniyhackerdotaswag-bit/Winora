<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--
              Full-bleed header band in the section hue. It runs the whole width of the sheet while
              the body below stays inside a capped column, so the colour belongs to the page rather
              than to a card sitting on it.
            -->
            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <!--
                  A star column with a cap: the content fills the width up to a comfortable measure
                  and then stops, staying at the left edge instead of drifting into the middle.
                -->
                <ColumnDefinition Width="*" MaxWidth="1800" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Padding="32,20,32,32">


                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Margin="{StaticResource WinoraStackGapL}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <!--
                  One line at the top instead of one on every row. What the rows used to carry was
                  the core's reason code printed verbatim, eight identical copies of it down the
                  screen, in the slot where a description of the setting belongs. The wording is the
                  cleanup screen's own — two phrasings of one fact is one too many.

                  Shown only when an administrator could actually write the settings in question.
                  A row blocked because this account can never elevate, or because Windows protects
                  the value, is not fixed by restarting, and a button there would promise what the
                  restart cannot deliver.
                -->
                <InfoBar IsOpen="{x:Bind ViewModel.NeedsElevation, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Margin="{StaticResource WinoraStackGapL}"
                         Message="{x:Bind ViewModel.ElevationNotice, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind Localized('Themes_RestartElevated')}"
                                Click="OnRestartElevatedClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--
                  Said once, above the rows it explains. The connection between the master switch
                  and the eleven padlocks below it existed only inside each padlock's tooltip,
                  which is to say only for somebody who already suspected it and hovered to check.
                  From any distance the screen read as settings that do not work.
                -->
                <InfoBar IsOpen="{x:Bind ViewModel.NeedsMaster, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Informational"
                         Margin="{StaticResource WinoraStackGapL}"
                         Message="{x:Bind ViewModel.MasterNotice, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind ViewModel.MasterAction, Mode=OneWay}"
                                Click="OnTurnOnEffectsClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--
                  Rows, not tiles. A tile spent 104 px on one name and one switch and needed two
                  columns to fit sixteen of them; a row spends 42 and fits them in one column with
                  room to spare. The order never changes: sorting the locked ones into their own
                  group was tried on paper and dropped, because then the screen looks different
                  depending on how the program was started, and a setting found yesterday is
                  somewhere else today.
                -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:VisualEffectRowViewModel">
                            <ctl:HoverRow>
                                <Grid Padding="4,10,6,10" ColumnSpacing="14"
                                      BorderBrush="{ThemeResource WinoraDividerBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind Label}" />
                                        <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind Detail}" />
                                    </StackPanel>

                                    <!--
                                      The ring gets a column of its own rather than sharing the
                                      switch's. Both were aligned right in the same cell, so while a
                                      change was being applied the ring sat on top of the switch's
                                      knob. The column is reserved whether or not the ring is
                                      showing, because a switch that jumps sideways the moment it is
                                      pressed is worse than one sitting slightly further left.
                                    -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="18" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" MinWidth="44">
                                        <ToggleSwitch IsOn="{x:Bind SwitchValue, Mode=TwoWay}"
                                                      OnContent=""
                                                      OffContent=""
                                                      MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      Visibility="{x:Bind ctl:XamlConvert.Hide(HasBlockReason), Mode=OneWay}"
                                                      IsEnabled="{x:Bind IsChangeable, Mode=OneWay}"
                                                      Toggled="OnToggled"
                                                      Tag="{x:Bind}"
                                                      AutomationProperties.Name="{x:Bind Label}" />

                                        <!--
                                          The exact reason lives here and nowhere else on screen. It
                                          is not thrown away and not replaced by a friendlier general
                                          sentence: there are eleven of them and they mean different
                                          things. It is wanted by whoever is working out why, and it
                                          is noise to everybody else.
                                        -->
                                        <FontIcon Glyph="&#xE72E;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="14"
                                                  HorizontalAlignment="Right"
                                                  Foreground="{ThemeResource WinoraTextMuted}"
                                                  Visibility="{x:Bind ctl:XamlConvert.Show(HasBlockReason), Mode=OneWay}"
                                                  ToolTipService.ToolTip="{x:Bind BlockReason, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind BlockReason, Mode=OneWay}" />

                                        </Grid>

                                        <ProgressRing Grid.Column="1"
                                                      IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                      Visibility="{x:Bind ctl:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                      Width="18" Height="18" />
                                    </Grid>
                                </Grid>
                            </ctl:HoverRow>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
