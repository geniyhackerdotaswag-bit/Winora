<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid Background="{ThemeResource WinoraHeaderSystem}" Padding="32,28,32,26">
                <FontIcon Glyph="&#xE9D5;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="112"
                          Opacity="0.06"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,48,0"
                          IsHitTestVisible="False"
                          AutomationProperties.AccessibilityView="Raw" />

                <StackPanel MaxWidth="1800" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource WinoraPageTitle}"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <Rectangle Style="{StaticResource WinoraRuleSystem}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,20,32,32">

                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,14"
                               Text="{x:Bind ViewModel.PrivacyNote, Mode=OneWay}" />

                    <Button Style="{StaticResource WinoraActionButton}"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource WinoraStackGapL}"
                            Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}"
                            Click="OnRefreshClick" />

                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,0"
                               Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsEmpty), Mode=OneWay}"
                               Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionRecordViewModel">
                                <Border Style="{StaticResource WinoraTile}" Margin="0,0,0,8">
                                    <ctl:HoverRow>
                                        <Grid Padding="18,13" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                           Text="{x:Bind Category, Mode=OneWay}" />

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                               Text="{x:Bind Status, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                               Opacity="0.7"
                                                               Text="{x:Bind Risk, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                               Opacity="0.7"
                                                               Visibility="{x:Bind ctl:XamlConvert.Show(NeededAdministrator), Mode=OneWay}"
                                                               Text="{x:Bind AdministratorLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource WinoraRowDetail}"
                                                       VerticalAlignment="Center"
                                                       Text="{x:Bind When, Mode=OneWay}" />
                                        </Grid>
                                    </ctl:HoverRow>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
