<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}"
                            SubtitleKey="Page_Sub_Changes" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,20,32,32">

                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Informational"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <Button Style="{StaticResource WinoraActionButton}"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource WinoraStackGapL}"
                            Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}"
                            Click="OnRefreshClick" />

                    <!-- An empty history is a normal state, not a failure, and says so. -->
                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,0"
                               Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsEmpty), Mode=OneWay}"
                               Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangeRecordViewModel">
                                <Border Style="{StaticResource WinoraTile}" Margin="0,0,0,8">
                                    <ctl:HoverRow>
                                        <Grid Padding="18,14" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                           TextWrapping="Wrap"
                                                           Text="{x:Bind Title, Mode=OneWay}" />

                                                <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                           Visibility="{x:Bind ctl:XamlConvert.Show(HasSummary), Mode=OneWay}"
                                                           Text="{x:Bind Summary, Mode=OneWay}" />

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                               Text="{x:Bind Outcome, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                               Opacity="0.7"
                                                               Text="{x:Bind When, Mode=OneWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="40">
                                                <Button Style="{StaticResource WinoraActionButton}"
                                                        Content="{x:Bind RollBackLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind ctl:XamlConvert.Show(CanRollBack), Mode=OneWay}"
                                                        Click="OnRollBackClick"
                                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />

                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind ctl:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                              Width="18" Height="18" />
                                            </Grid>
                                        </Grid>
                                    </ctl:HoverRow>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
