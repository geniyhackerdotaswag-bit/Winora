<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.BypassPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,24,32,32">

                    <InfoBar IsOpen="{x:Bind ViewModel.HasForeignWarning, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Warning"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.ForeignWarning, Mode=OneWay}" />

                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Informational"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Lit only while Winora's own copy is running. -->
                                <Ellipse Width="9" Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource WinoraHueSystem}"
                                         Opacity="{x:Bind ctl:XamlConvert.BarOpacity(ViewModel.IsRunning), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource WinoraRowTitle}"
                                           Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                        Click="OnStartClick" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.StopLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                                        Click="OnStopClick" />
                            </StackPanel>

                            <!--
                              The one question Winora cannot answer for itself. It can see that
                              winws.exe is alive; whether Discord opened is not something any probe
                              would tell it, because what counts as working is whatever the person
                              came here to do. Asked once, and only after something was started.
                            -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsAskingVerdict), Mode=OneWay}">
                                <TextBlock Style="{StaticResource WinoraRowDetail}"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Text="{x:Bind ViewModel.VerdictQuestion, Mode=OneWay}" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.VerdictYes, Mode=OneWay}"
                                        Click="OnWorkedClick" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.VerdictNo, Mode=OneWay}"
                                        Click="OnDidNotWorkClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.HasReleaseNote), Mode=OneWay}"
                                       Text="{x:Bind ViewModel.ReleaseNote, Mode=OneWay}" />

                            <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                         Maximum="100"
                                         Visibility="{x:Bind ctl:XamlConvert.Show(ViewModel.IsBusy), Mode=OneWay}"
                                         AutomationProperties.AccessibilityView="Raw" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.CheckLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsBusy), Mode=OneWay}"
                                        Click="OnCheckClick" />
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Content="{x:Bind ViewModel.InstallLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                                        Click="OnInstallClick" />
                                <!--
                                  Replaces the path that used to be printed above it. The folder is
                                  still reachable; it is just no longer written across the screen.
                                -->
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.OpenFolderLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.IsInstalled, Mode=OneWay}"
                                        Click="OnOpenFolderClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.StrategiesHeading, Mode=OneWay}" />

                    <!--
                      Whose work this is. Every strategy in the list below is a file from Flowseal's
                      release, read but not altered, and the executable they start is his. A program
                      built on somebody else's work should say so where the work is being used.
                    -->
                    <HyperlinkButton NavigateUri="https://github.com/Flowseal/zapret-discord-youtube"
                                     Margin="2,0,0,6"
                                     Padding="0"
                                     Content="{x:Bind ViewModel.Disclosure, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,0"
                               Visibility="{x:Bind ctl:XamlConvert.Hide(ViewModel.IsInstalled), Mode=OneWay}"
                               Text="{x:Bind ViewModel.NotInstalledMessage, Mode=OneWay}" />

                    <!--
                      Everything has been tried and none of it helped. Saying so is more use than
                      leaving the list looking as though there were somewhere left to go.
                    -->
                    <InfoBar IsOpen="{x:Bind ViewModel.IsExhausted, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Warning"
                             Margin="0,10,0,0"
                             Message="{x:Bind ViewModel.ExhaustedNote, Mode=OneWay}" />

                    <!--
                      One column, not a grid of tiles. Twelve equal tiles read as a menu somebody
                      chooses from with knowledge, and nobody has that knowledge — which strategy
                      works depends on the network in front of it. A list read top to bottom is what
                      a search looks like, and each row now says what happened last time.
                    -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Strategies}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BypassStrategyViewModel">
                                <Button Style="{StaticResource WinoraSelectableTile}"
                                        Tag="{x:Bind}"
                                        Click="OnStrategyClick"
                                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- The release's own file name, unchanged. -->
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource WinoraStrategyId}"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind Name, Mode=OneWay}" />

                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource WinoraRowDetail}"
                                                   VerticalAlignment="Center"
                                                   Margin="0"
                                                   Text="{x:Bind OutcomeText, Mode=OneWay}" />

                                        <FontIcon Grid.Column="2"
                                                  Glyph="&#xE73E;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="15"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind ctl:XamlConvert.Show(IsSelected), Mode=OneWay}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
