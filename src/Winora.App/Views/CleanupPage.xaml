<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--
              Full-bleed header band in the section hue. It runs the whole width of the sheet while
              the body below stays inside a capped column, so the colour belongs to the page rather
              than to a card sitting on it.
            -->
            <Grid Background="{ThemeResource WinoraHeaderMaintenance}" Padding="32,28,32,26">
                <!--
                  A watermark of the section's own icon, large and faint, filling the empty right
                  half of the band. Purely decorative, so it is hidden from assistive technology
                  rather than read out as an unlabelled image.
                -->
                <FontIcon Glyph="&#xE74D;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="112"
                          Opacity="0.06"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,48,0"
                          IsHitTestVisible="False"
                          AutomationProperties.AccessibilityView="Raw" />

                <StackPanel MaxWidth="1800" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource WinoraPageTitle}"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <Rectangle Style="{StaticResource WinoraRuleMaintenance}" />
                </StackPanel>
            </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <!--
                  A star column with a cap: the content fills the width up to a comfortable measure
                  and then stops, staying at the left edge instead of drifting into the middle.
                -->
                <ColumnDefinition Width="*" MaxWidth="1800" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Padding="32,20,32,32">


                <!-- The number that answers "is this worth doing", read before any row. -->
                <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}"
                        Background="{ThemeResource WinoraWashMaintenance}"
                        HorizontalAlignment="Left" MinWidth="240">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WinoraMetricCaption}"
                                   Text="{x:Bind ViewModel.ReclaimableCaption, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource WinoraMetric}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{x:Bind ViewModel.ReclaimableValue, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Success"
                         Margin="{StaticResource WinoraStackGapL}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <Border Style="{StaticResource WinoraGroup}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CleanupRowViewModel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ctl:HoverRow Grid.Row="0">
                                        <Grid Padding="{StaticResource WinoraRowPadding}" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource WinoraRowTitle}" Text="{x:Bind Label}" />
                                                <!-- The real path, so the user knows exactly what is going. -->
                                                <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                           Text="{x:Bind Path}"
                                                           IsTextSelectionEnabled="True" />
                                                <TextBlock Style="{StaticResource WinoraRowWarning}"
                                                           Text="{x:Bind Note}"
                                                           Visibility="{x:Bind ctl:XamlConvert.Show(HasNote)}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource WinoraRowTitle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind Size, Mode=OneWay}" />

                                            <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="96">
                                                <Button HorizontalAlignment="Right"
                                                        Style="{StaticResource WinoraActionButton}"
                                                        Content="{x:Bind ActionLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        IsEnabled="{x:Bind CanClean, Mode=OneWay}"
                                                        Visibility="{x:Bind ctl:XamlConvert.Show(ShowAction), Mode=OneWay}"
                                                        Click="OnActionClick"
                                                        AutomationProperties.Name="{x:Bind Label}" />
                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind ctl:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                              Width="18" Height="18"
                                                              HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </ctl:HoverRow>

                                    <Rectangle Grid.Row="1" Style="{StaticResource WinoraRowDivider}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
