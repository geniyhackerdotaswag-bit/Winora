<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:conv="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

            <!-- Deletion is irreversible, so the warning sits above the buttons, not after them. -->
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Warning"
                     Margin="{StaticResource WinoraStackGapM}"
                     Message="{x:Bind ViewModel.PermanentNotice, Mode=OneWay}" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Success"
                     Margin="{StaticResource WinoraStackGapL}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <TextBlock Style="{StaticResource WinoraSectionHeading}"
                       Text="{x:Bind ViewModel.ReclaimableTotal, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupRowViewModel">
                        <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapM}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Label}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Path}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{x:Bind Note}"
                                               Visibility="{x:Bind conv:XamlConvert.Show(IsProtected)}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Text="{x:Bind Size, Mode=OneWay}" />
                                    <Button HorizontalAlignment="Right"
                                            Content="{x:Bind ActionLabel, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanClean, Mode=OneWay}"
                                            Visibility="{x:Bind conv:XamlConvert.Show(CanClean), Mode=OneWay}"
                                            Click="OnActionClick" />
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind conv:XamlConvert.Show(IsBusy), Mode=OneWay}"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
