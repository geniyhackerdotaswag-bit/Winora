<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,24,32,32">

                    <!--
                      Winora's own colours live here rather than in the personalization group of the
                      pane: that group is for screens that change Windows, and an item there implied
                      this one did too.
                    -->
                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.AppearanceHeading, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.AppearanceDescription, Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WinoraActionButton}"
                                    Content="{x:Bind ViewModel.AppearanceLabel, Mode=OneWay}"
                                    Click="OnAppearanceClick" />
                        </Grid>
                    </Border>

                    <!--
                      Carrying settings to another machine, as a file. Here rather than in the pane
                      for the same reason the colours are: this is a rare thing to want, and the
                      pane is for the screens somebody opens to change something today.

                      A file, not an account. The two buttons below do what a server would do for
                      this purpose, and cost nobody a password, a host or a thing that can be down.
                    -->
                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.TransferHeading, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}">
                        <StackPanel Spacing="12">
                            
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource WinoraActionButton}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsTransferBusy), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.TransferSaveLabel, Mode=OneWay}"
                                        Click="OnTransferSaveClick" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        IsEnabled="{x:Bind ctl:XamlConvert.Not(ViewModel.IsTransferBusy), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.TransferLoadLabel, Mode=OneWay}"
                                        Click="OnTransferLoadClick" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ctl:XamlConvert.ShowText(ViewModel.TransferMessage), Mode=OneWay}"
                                       Text="{x:Bind ViewModel.TransferMessage, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--
                      Winora already checks for a new version by itself at startup
                      (UpdateViewModel.StartupAsync); this is the same check, run on request, for the
                      moment somebody wants an answer right now instead of waiting. Collapsed whole in
                      the packaged build, where a "Проверить" button could only ever report a version
                      nobody here is able to install.
                    -->
                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Visibility="{x:Bind ctl:XamlConvert.Show(Update.IsSettingsSectionVisible), Mode=OneWay}"
                               Text="{x:Bind Update.SettingsHeading, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraCard}"
                            Margin="{StaticResource WinoraStackGapL}"
                            Visibility="{x:Bind ctl:XamlConvert.Show(Update.IsSettingsSectionVisible), Mode=OneWay}">
                        <!--
                          The button alone. The card said the same thing three times over — what the
                          check does, which version is installed, and what the last answer was — and
                          the answer already has a home: the strip at the top of the window, which is
                          where every other thing Winora has to say about itself appears.
                        -->
                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource WinoraActionButton}"
                                Content="{x:Bind Update.SettingsCheckLabel, Mode=OneWay}"
                                Command="{x:Bind Update.CheckCommand}"
                                IsEnabled="{x:Bind ctl:XamlConvert.Not(Update.IsBusy), Mode=OneWay}" />
                    </Border>

                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.StorageHeading, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource WinoraRowDetail}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,10"
                               Text="{x:Bind ViewModel.StorageNote, Mode=OneWay}" />

                    <Button Style="{StaticResource WinoraActionButton}"
                            HorizontalAlignment="Left"
                            Content="{x:Bind ViewModel.OpenFolderLabel, Mode=OneWay}"
                            Click="OnOpenFolderClick" />

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
