<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.ChangeReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinoraPagePadding}">

            <TextBlock Style="{StaticResource WinoraPageTitle}" x:Name="Heading" />
            <TextBlock Style="{StaticResource WinoraPageSubtitle}"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapL}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.TargetId, Mode=OneWay}" />

                    <!-- The exact diff: what the target holds now and what it would hold. -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="{x:Bind ViewModel.CurrentValueText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="&#x2192;" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="{x:Bind ViewModel.ProposedValueText, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.Facts, Mode=OneWay}" />

                    <!-- Every mutating adapter carries its Microsoft Learn URI; the user can read it. -->
                    <HyperlinkButton NavigateUri="{x:Bind ViewModel.DocumentationUri, Mode=OneWay}"
                                     Content="{x:Bind ViewModel.DocumentationUri, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind ViewModel.PlanDigest, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- A disabled primary action always states why, never silently. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasApplyBlockReason, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Margin="{StaticResource WinoraStackGapL}"
                     Message="{x:Bind ViewModel.ApplyBlockReason, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.ApplyBlockReason, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmCommand}" />
                <Button x:Name="CancelButton"
                        Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
