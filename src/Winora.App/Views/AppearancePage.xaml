<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winora.App.ViewModels"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1800" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="32,24,32,32">

                    <!--
                      While Windows is in High Contrast the scheme is not painted at all. Said on the
                      page rather than left as a puzzle, because every control below still works and
                      nothing on screen would otherwise change when Apply is pressed.
                    -->
                    <InfoBar IsOpen="{x:Bind ViewModel.IsSuppressed, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Informational"
                             Margin="{StaticResource WinoraStackGapL}"
                             Message="{x:Bind ViewModel.SuppressedNotice, Mode=OneWay}" />

                    <!-- Ready-made schemes -->

                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.PresetsHeading, Mode=OneWay}" />


                    <ItemsControl ItemsSource="{x:Bind ViewModel.Presets}"
                                  Margin="{StaticResource WinoraStackGapXl}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearancePresetViewModel">
                                <Button Click="OnPresetClick"
                                        Tag="{x:Bind Id}"
                                        Padding="10,7,14,7"
                                        CornerRadius="{StaticResource WinoraControlRadius}"
                                        Background="{ThemeResource WinoraCardFill}"
                                        BorderBrush="{ThemeResource WinoraCardStroke}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="26"
                                                Height="20"
                                                CornerRadius="5"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource WinoraStrokeBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0"
                                                           Fill="{x:Bind ctl:XamlConvert.Swatch(CanvasColor), Mode=OneWay}" />
                                                <Rectangle Grid.Column="1"
                                                           Fill="{x:Bind ctl:XamlConvert.Swatch(AccentColor), Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{x:Bind Name}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{ThemeResource WinoraTextFaint}"
                                                   Text="{x:Bind Variant}" />
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="14"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource WinoraHuePersonalization}"
                                                  Visibility="{x:Bind ctl:XamlConvert.Show(IsSelected), Mode=OneWay}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                      Apply and revert sit here, under the schemes, rather than at the foot of the
                      page. Picking a ready-made scheme is what most visits to this screen are, and
                      the button that finishes that visit was three sections and a scroll away.
                    -->

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                Margin="{StaticResource WinoraStackGapXl}">
                        <Button Style="{StaticResource WinoraActionButton}"
                                IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                                Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}"
                                Click="OnApplyClick" />
                        <Button Style="{StaticResource WinoraActionButton}"
                                Content="{x:Bind ViewModel.ResetLabel, Mode=OneWay}"
                                Click="OnResetClick" />
                    </StackPanel>

                    <!-- Only when the scheme is refused. See AppearanceViewModel.ShowGate. -->
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowGate, Mode=OneWay}"
                             IsClosable="False"
                             Margin="{StaticResource WinoraStackGapL}"
                             Severity="{x:Bind ctl:XamlConvert.InfoSeverity(ViewModel.CanApply), Mode=OneWay}"
                             Title="{x:Bind ViewModel.GateTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.GateMessage, Mode=OneWay}" />

                    <InfoBar IsOpen="{x:Bind ViewModel.ShowSaved, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Success"
                             Margin="0,14,0,0"
                             Message="{x:Bind ViewModel.SavedNotice, Mode=OneWay}" />

                    <!-- The two chosen colours, plus the one derived from the accent -->

                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.CustomHeading, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraGroup}">
                        <StackPanel>

                            <ctl:HoverRow>
                                <Grid Padding="{StaticResource WinoraRowPadding}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                   Text="{x:Bind ViewModel.CanvasLabel, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                   Text="{x:Bind ViewModel.CanvasHint, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="8"
                                            CornerRadius="{StaticResource WinoraControlRadius}"
                                            AutomationProperties.Name="{x:Bind ViewModel.CanvasLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="26"
                                                    Height="20"
                                                    CornerRadius="5"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource WinoraStrokeBrush}"
                                                    Background="{x:Bind ctl:XamlConvert.Swatch(ViewModel.CanvasColor), Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Text="{x:Bind ViewModel.CanvasHex, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="CanvasPicker"
                                                             IsAlphaEnabled="False"
                                                             IsHexInputVisible="True"
                                                             IsColorSliderVisible="True"
                                                             IsMoreButtonVisible="False"
                                                             Color="{x:Bind ViewModel.CanvasColor, Mode=OneWay}"
                                                             ColorChanged="OnCanvasColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </ctl:HoverRow>

                            <Rectangle Style="{StaticResource WinoraRowDivider}" />

                            <ctl:HoverRow>
                                <Grid Padding="{StaticResource WinoraRowPadding}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                   Text="{x:Bind ViewModel.AccentLabel, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="8"
                                            CornerRadius="{StaticResource WinoraControlRadius}"
                                            AutomationProperties.Name="{x:Bind ViewModel.AccentLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="26"
                                                    Height="20"
                                                    CornerRadius="5"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource WinoraStrokeBrush}"
                                                    Background="{x:Bind ctl:XamlConvert.Swatch(ViewModel.AccentColor), Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Text="{x:Bind ViewModel.AccentHex, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="AccentPicker"
                                                             IsAlphaEnabled="False"
                                                             IsHexInputVisible="True"
                                                             IsColorSliderVisible="True"
                                                             IsMoreButtonVisible="False"
                                                             Color="{x:Bind ViewModel.AccentColor, Mode=OneWay}"
                                                             ColorChanged="OnAccentColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </ctl:HoverRow>

                            <Rectangle Style="{StaticResource WinoraRowDivider}" />

                            <ctl:HoverRow>
                                <Grid Padding="{StaticResource WinoraRowPadding}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource WinoraRowTitle}"
                                                   Text="{x:Bind ViewModel.OnAccentLabel, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource WinoraRowDetail}"
                                                   Text="{x:Bind ViewModel.OnAccentHint, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="8"
                                            CornerRadius="{StaticResource WinoraControlRadius}"
                                            AutomationProperties.Name="{x:Bind ViewModel.OnAccentLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="26"
                                                    Height="20"
                                                    CornerRadius="5"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource WinoraStrokeBrush}"
                                                    Background="{x:Bind ctl:XamlConvert.Swatch(ViewModel.OnAccentColor), Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Text="{x:Bind ViewModel.OnAccentHex, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="OnAccentPicker"
                                                             IsAlphaEnabled="False"
                                                             IsHexInputVisible="True"
                                                             IsColorSliderVisible="True"
                                                             IsMoreButtonVisible="False"
                                                             Color="{x:Bind ViewModel.OnAccentColor, Mode=OneWay}"
                                                             ColorChanged="OnOnAccentColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </ctl:HoverRow>
                        </StackPanel>
                    </Border>

                    <!--
                      Matching Windows itself, through a Windows theme file: a copy of the one
                      already in use with the mode and accent lines changed, so wallpaper, cursors
                      and sounds carry over untouched. Only on a press, and the cost is stated above
                      the button rather than discovered after it — the Settings window opens,
                      because that is the only way Windows adopts a theme.
                    -->
                    <TextBlock Style="{StaticResource WinoraSectionHeading}"
                               Text="{x:Bind ViewModel.WindowsHeading, Mode=OneWay}" />

                    <Border Style="{StaticResource WinoraCard}" Margin="{StaticResource WinoraStackGapXl}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.WindowsDescription, Mode=OneWay}" />

                            <!-- Said before the press, not after it. -->
                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.WindowsCost, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource WinoraPrimaryButton}"
                                        Content="{x:Bind ViewModel.WindowsApplyLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanApplyToWindows, Mode=OneWay}"
                                        Click="OnApplyToWindowsClick" />
                                <Button Style="{StaticResource WinoraActionButton}"
                                        Content="{x:Bind ViewModel.WindowsOpenLabel, Mode=OneWay}"
                                        Click="OnOpenWindowsColorsClick" />
                                <ProgressRing VerticalAlignment="Center"
                                              Width="18"
                                              Height="18"
                                              IsActive="{x:Bind ViewModel.IsApplyingToWindows, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsApplyingToWindows, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource WinoraRowDetail}"
                                       Margin="0"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ShowWindowsResult, Mode=OneWay}"
                                       Text="{x:Bind ViewModel.WindowsResult, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
