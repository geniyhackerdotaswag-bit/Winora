<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winora.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Winora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ctl:PageHeader Heading="{x:Bind ViewModel.Heading, Mode=OneWay}" />

            <!--
              A column, not a field. Every other page caps its content at 1800 because every other
              page is a list of rows that genuinely wants the width; this one is a card and a form,
              and a form smeared across a wide monitor is the look the cabinet was rewritten to get
              away from. WinoraBodyMaxWidth is the token the house already keeps for content meant
              to be read rather than scanned, which is what this is.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource WinoraBodyMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Padding="{StaticResource WinoraPagePadding}">

                    <ctl:ProfileCard x:Name="Card" Margin="{StaticResource WinoraStackGapL}" />

                    <!--
                      Единственная дверь к экрану подписки: пункт из панели убран, а
                      ключ вводить где-то надо. Ссылка стоит прямо под карточкой,
                      где на строке «Подписка: …» человек и обнаруживает, что срок
                      кончается. Кнопка скромная, а не основная: платят на сайте, а
                      здесь только вводят то, что уже куплено.
                    -->
                    <HyperlinkButton Margin="{StaticResource WinoraStackGapL}"
                                     Padding="0"
                                     Click="OnLicenceClick"
                                     Content="{x:Bind Localized('Profile_SubManage')}" />

                    <!--
                      Both sections fold away, and start folded. The card above already shows the
                      name, the mail and the picture — which is what somebody opens this screen to
                      look at. These two are for changing them, which is a rarer thing to want, and
                      unfolded they pushed everything else off the screen.
                    -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Margin="{StaticResource WinoraStackGapL}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon AutomationProperties.AccessibilityView="Raw"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="13"
                                          Foreground="{ThemeResource WinoraTextFaint}"
                                          Glyph="&#xE70F;"
                                          VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.DetailsHeading, Mode=OneWay}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>

                            <StackPanel Padding="4,8,4,8" Spacing="18">

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                               Text="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />

                                    <!--
                                      The icon is a sibling drawn over the left padding rather than
                                      part of the control, which is how the registration window does
                                      it. The TextBox keeps the platform's own template, so the
                                      focus underline, the selection colours and High Contrast are
                                      all still the platform's.
                                    -->
                                    <Grid>
                                        <TextBox x:Name="NameBox"
                                                 Style="{StaticResource WinoraFieldBox}"
                                                 AutomationProperties.Name="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                                                 PlaceholderText="{x:Bind ViewModel.NamePlaceholder, Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <FontIcon AutomationProperties.AccessibilityView="Raw"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource WinoraTextFaint}"
                                                  Glyph="&#xE77B;"
                                                  HorizontalAlignment="Left"
                                                  Margin="13,0,0,0"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                               Text="{x:Bind ViewModel.EmailLabel, Mode=OneWay}" />

                                    <Grid>
                                        <TextBox x:Name="EmailBox"
                                                 Style="{StaticResource WinoraFieldBox}"
                                                 AutomationProperties.Name="{x:Bind ViewModel.EmailLabel, Mode=OneWay}"
                                                 PlaceholderText="{x:Bind ViewModel.EmailPlaceholder, Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <FontIcon AutomationProperties.AccessibilityView="Raw"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="15"
                                                  Foreground="{ThemeResource WinoraTextFaint}"
                                                  Glyph="&#xE715;"
                                                  HorizontalAlignment="Left"
                                                  Margin="13,0,0,0"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                </StackPanel>

                                <Rectangle Height="1"
                                           Fill="{ThemeResource WinoraDividerBrush}"
                                           Margin="0,2,0,2" />

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                      Dead until the name and the address are both answerable, as
                                      the registration card's action is. The command already refuses
                                      in that state; this is the button admitting it rather than
                                      taking a press and doing nothing with it.
                                    -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource WinoraPrimaryButton}"
                                            Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SaveCommand}" />

                                    <!--
                                      Hidden while empty. A status line bound to an empty string
                                      still takes its line height, and a gap that opens and closes
                                      beside the button as somebody types reads as a flinch.
                                    -->
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource WinoraRowDetail}"
                                               Margin="0"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ctl:XamlConvert.ShowText(ViewModel.StatusMessage), Mode=OneWay}"
                                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!--
                      The pictures, in a card of their own.

                      Not folded into the details card above it: that one is a form with one action
                      at the bottom, and these are two pairs of buttons that each act immediately.
                      Mixing them would put four buttons that do things next to one button that
                      saves, and leave it ambiguous which of them "Сохранить" applies to.

                      Each half states its limits above its buttons rather than only complaining
                      afterwards, and keeps its own line for a refusal underneath them. A single
                      shared message line would show a complaint about the avatar under the
                      background's buttons.
                    -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon AutomationProperties.AccessibilityView="Raw"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="13"
                                          Foreground="{ThemeResource WinoraTextFaint}"
                                          Glyph="&#xE91B;"
                                          VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.PicturesHeading, Mode=OneWay}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>

                            <StackPanel Padding="4,8,4,8" Spacing="18">

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                               Text="{x:Bind ViewModel.AvatarPictureLabel, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                Margin="0,6,0,0">
                                        <Button x:Name="ChooseAvatarButton"
                                                Style="{StaticResource WinoraActionButton}"
                                                Content="{x:Bind ViewModel.ChoosePictureLabel, Mode=OneWay}"
                                                Click="OnChooseAvatarClick" />

                                        <!--
                                          Dead while there is nothing to remove, rather than absent.
                                          A button that appears and disappears moves the one beside
                                          it, and the person who has just chosen a bad photograph is
                                          aiming at exactly that spot.
                                        -->
                                        <Button x:Name="RemoveAvatarButton"
                                                Style="{StaticResource WinoraActionButton}"
                                                Content="{x:Bind ViewModel.RemovePictureLabel, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.HasAvatarImage, Mode=OneWay}"
                                                Click="OnRemoveAvatarClick" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource WinoraRowWarning}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind ctl:XamlConvert.ShowText(ViewModel.AvatarPictureMessage), Mode=OneWay}"
                                               Text="{x:Bind ViewModel.AvatarPictureMessage, Mode=OneWay}" />
                                </StackPanel>

                                <Rectangle Height="1"
                                           Fill="{ThemeResource WinoraDividerBrush}"
                                           Margin="0,2,0,2" />

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource WinoraFieldLabel}"
                                               Text="{x:Bind ViewModel.BackgroundPictureLabel, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                Margin="0,6,0,0">
                                        <Button x:Name="ChooseBackgroundButton"
                                                Style="{StaticResource WinoraActionButton}"
                                                Content="{x:Bind ViewModel.ChoosePictureLabel, Mode=OneWay}"
                                                Click="OnChooseBackgroundClick" />
                                        <Button x:Name="RemoveBackgroundButton"
                                                Style="{StaticResource WinoraActionButton}"
                                                Content="{x:Bind ViewModel.RemovePictureLabel, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.HasBackgroundImage, Mode=OneWay}"
                                                Click="OnRemoveBackgroundClick" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource WinoraRowWarning}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind ctl:XamlConvert.ShowText(ViewModel.BackgroundPictureMessage), Mode=OneWay}"
                                               Text="{x:Bind ViewModel.BackgroundPictureMessage, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
